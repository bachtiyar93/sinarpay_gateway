# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://sinarpay:sinarpay_password@localhost:5432/sinarpay_db?schema=public

# Redis Configuration (Cache, Idempotency & Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Secrets
JWT_SECRET=sinarpay_super_secret_jwt_key_32bytes_minimum_length_required!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=sinarpay_super_secret_refresh_key_32bytes_minimum!
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM 32-byte hex key for encrypting sensitive fields at rest (e.g. merchant apiSecret)
# Example 32-byte (64 hex characters) key:
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Bank / Switching Simulator Secret for Callback HMAC Signature verification
BANK_CALLBACK_SECRET=sinarpay_bank_simulator_secret_key_123

# Webhook Retries
WEBHOOK_MAX_RETRIES=5
