# ============================================================================
# SinarPay Backend - Environment Variables
# ============================================================================
# Copy this file to .env and update values for your environment
# Do NOT commit .env to git (add to .gitignore)
# ============================================================================

# ============================================================================
# Server Configuration
# ============================================================================
PORT=3000
NODE_ENV=development

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://sinarpay:sinarpay_password@localhost:5432/sinarpay_db?schema=public

# ============================================================================
# Redis Configuration (Cache, Idempotency & Queue)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# Authentication & Security
# ============================================================================
# JWT Secret (minimum 32 characters for security)
JWT_SECRET=your_jwt_secret_key_min_32_chars_required_for_security!

# JWT Token Expiration (e.g., "1h", "24h", "7d")
JWT_EXPIRES_IN=1d

# JWT Refresh Secret (minimum 32 characters)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars_for_security!

# JWT Refresh Token Expiration
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# Encryption
# ============================================================================
# AES-256-GCM encryption key for sensitive data at-rest (32-byte hex string)
# Generate: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================================================
# Bank/Switching Simulator
# ============================================================================
# Secret for HMAC signature validation on bank callbacks
BANK_CALLBACK_SECRET=sinarpay_bank_simulator_secret_key_minimum_32_characters!

# ============================================================================
# Webhook Configuration
# ============================================================================
# Maximum number of webhook delivery retries
WEBHOOK_MAX_RETRIES=5

# ============================================================================
# Optional: Logging (for Phase 6+)
# ============================================================================
# LOG_LEVEL=info
# LOG_FILE=/var/log/sinarpay/app.log

# ============================================================================
# Optional: Frontend CORS Configuration (for Phase 2+)
# ============================================================================
FRONTEND_URL=http://localhost:3001
# CORS_ORIGIN=http://localhost:3001

# Demo merchant used by local frontend payment generation
MERCHANT_NAME=Demo Merchant
MERCHANT_API_KEY=merchant-demo-key
MERCHANT_API_SECRET=merchant-demo-secret

# ============================================================================
# Optional: Rate Limiting (for Phase 7+)
# ============================================================================
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000
